+			delete g_pToolsDlg;
+			g_pToolsDlg = NULL;
+			return;
+		}
+		g_pToolsDlg->ShowWindow(SW_SHOW);
+		return;
+	}
+
+	g_pToolsDlg->ShowWindow(g_pToolsDlg->IsWindowVisible() ? SW_HIDE : SW_SHOW);
+}
