+//------------------------------------------------------------------
+// Reticle
+//------------------------------------------------------------------
+
+
+// Height of the terrain's surface at (x, z), from its prism tops.
+static bool Terrain_HeightAt(CWorldNode *pNode, float x, float z, float &y)
+{
+	LTVector orig(x, 1e6f, z), dir(0.0f, -1.0f, 0.0f);
+	float bestT = 1e30f;
+	for(GPOS pos = pNode->m_Children.GetHeadPosition(); pos; )
+	{
+		CWorldNode *pChild = pNode->m_Children.GetNext(pos);
+		if(pChild->GetType() != Node_Brush)
+			continue;
+		CEditBrush *pBrush = pChild->AsBrush();
+		if(!Terrain_IsTerrainBrush(pBrush))
+			continue;
+		Terrain_RayBrush(pBrush, orig, dir, bestT);
+	}
+	if(bestT > 1e29f)
+		return false;
+	y = orig.y - bestT;
+	return true;
+}
+
+static bool Terrain_NodeInRegion(CEditRegion *pRegion, CWorldNode *pNode)
+{
+	std::vector<CWorldNode*> nodes;
+	Terrain_FindNodes(pRegion->GetRootNode(), nodes);
+	for(size_t n=0; n < nodes.size(); n++)
+		if(nodes[n] == pNode)
+			return true;
+	return false;
+}
+
+void Terrain::UpdateHover(CRegionView *pView, CPoint point)
+{
+	if(!IsActive())
+	{
+		if(g_bHover)
+		{
+			g_bHover = false;
+			pView->GetRegionDoc()->RedrawAllViews();
+		}
+		return;
+	}
+
+	CWorldNode *pNode;
+	LTVector hit;
+	bool bHit = Terrain_Pick(pView, point, &pNode, &hit);
+	if(!bHit && !g_bHover)
+		return;
+
+	g_bHover = bHit;
+	if(bHit)
+	{
+		g_pHoverNode = pNode;
+		g_vHover = hit;
+	}
+	pView->GetRegionDoc()->RedrawAllViews();
+}
+
+void Terrain::DrawReticle(DrawBase *pDraw)
+{
+	if(!g_bHover || !IsActive() || !g_pHoverNode)
+		return;
+	if(!Terrain_NodeInRegion(pDraw->m_pView->GetRegion(), g_pHoverNode))
+	{
+		g_bHover = false;
+		return;
+	}
+
+	const DWORD color = 0xFF30FF30;
+	const DWORD centerColor = 0xFFFFFF30;
+	const int nSegs = 40;
+	const float lift = 1.0f;
+
+	pDraw->ZEnable(FALSE);
+
+	// Brush circle draped over the surface.
+	LTVector prev;
+	for(int i=0; i <= nSegs; i++)
+	{
+		float a = (float)i / (float)nSegs * 6.2831853f;
+		float x = g_vHover.x + (float)cos(a) * g_Radius;
+		float z = g_vHover.z + (float)sin(a) * g_Radius;
+		float y = g_vHover.y;
+		Terrain_HeightAt(g_pHoverNode, x, z, y);
+		LTVector cur(x, y + lift, z);
+		if(i > 0)
+			pDraw->TransformAndDrawLine(prev, cur, color);
+		prev = cur;
+	}
+
+	// Inner ring at half radius and a centre spike scaled by strength.
+	for(int i=0; i <= nSegs / 2; i++)
+	{
+		float a = (float)i / (float)(nSegs / 2) * 6.2831853f;
+		float x = g_vHover.x + (float)cos(a) * g_Radius * 0.5f;
+		float z = g_vHover.z + (float)sin(a) * g_Radius * 0.5f;
+		float y = g_vHover.y;
+		Terrain_HeightAt(g_pHoverNode, x, z, y);
+		LTVector cur(x, y + lift, z);
+		if(i > 0)
+			pDraw->TransformAndDrawLine(prev, cur, color);
+		prev = cur;
+	}
+
+	float spike = 8.0f + g_Radius * 0.25f * (float)g_Strength / 100.0f;
+	{
+		int eff = Terrain_EffectiveMode(false);
+		if(eff == MODE_LOWER)
+			spike = -spike;
+		else if(eff == MODE_SMOOTH)
+			spike *= 0.25f;
+	}
+	LTVector top(g_vHover.x, g_vHover.y + spike, g_vHover.z);
+	pDraw->TransformAndDrawLine(g_vHover, top, centerColor);
+	float c = g_Radius * 0.08f + 2.0f;
+	pDraw->TransformAndDrawLine(LTVector(g_vHover.x - c, g_vHover.y + lift, g_vHover.z), LTVector(g_vHover.x + c, g_vHover.y + lift, g_vHover.z), centerColor);
+	pDraw->TransformAndDrawLine(LTVector(g_vHover.x, g_vHover.y + lift, g_vHover.z - c), LTVector(g_vHover.x, g_vHover.y + lift, g_vHover.z + c), centerColor);
+
+	pDraw->ZEnable(pDraw->m_pView->IsPerspectiveViewType());
+}
+
+bool Terrain::BlocksSelection()
+{
+	if(!IsToolsWindowVisible())
+		return false;
+
+	// Let the navigation hotkeys (move / rotate / orbit / draw poly) through.
+	static const int navKeys[] = { 'I', 'O', 'L', VK_SPACE };
+	for(int i=0; i < sizeof(navKeys) / sizeof(navKeys[0]); i++)
+		if(GetKeyState(navKeys[i]) & 0x8000)
+			return false;
+	return true;
+}
diff --git a/tools/DEdit/Terrain/Terrain.h b/tools/DEdit/Terrain/Terrain.h
new file mode 100644
index 0000000..e6f9f49
--- /dev/null
+++ b/tools/DEdit/Terrain/Terrain.h
@@ -0,0 +1,68 @@
+//------------------------------------------------------------------
+//
+//	FILE	  : Terrain.h
+//
+//	PURPOSE	  : Paintable terrain. A brush is converted into a grid of
+//	            triangular prism brushes (one per triangle) grouped under
+//	            a "TerrainNNNN" node. Heights are painted straight into the
+//	            prisms; blended texture layers are baked into
+//	            Textures\Terrainmesh\NNNN.dtx (32 bit DTX) and kept in
+//	            Textures\Terrainmesh\NNNN.trn.
+//
+//------------------------------------------------------------------
+
+#ifndef __TERRAIN_H__
+#define __TERRAIN_H__
+
+class CRegionView;
+class DrawBase;
+
+namespace Terrain
+{
+	enum
+	{
+		MODE_RAISE = 0,
+		MODE_LOWER,
+		MODE_SMOOTH,
+		MODE_FLATTEN,
+		MODE_PAINT1,
+		MODE_PAINT2,
+		MODE_PAINT3,
+		MODE_PAINT4,
+		NUM_MODES
+	};
+
+	// Brush -> Convert to Terrain.
+	void	ConvertSelection(CRegionView *pView);
+
+	// Brush -> Terrain Tools (shows / hides the tool window).
+	void	ToggleToolsWindow();
+	bool	IsToolsWindowVisible();
+
+	// Painting is active while the tool window is open with "Paint" checked.
+	bool	IsActive();
+	bool	IsStroking();
+
+	// While the tool window is open, left clicks don't select (camera
+	// navigation keys still work).
+	bool	BlocksSelection();
+
+	// Mouse hooks for the region views. BeginStroke returns false if the
+	// click didn't hit a terrain (so the view handles it normally).
+	// Left button uses the selected mode; the right button inverts Raise / Lower.
+	// Holding Shift (height modes) smooths instead.
+	bool	BeginStroke(CRegionView *pView, CPoint point, bool bRightButton = false);
+	bool	IsStrokeRightButton();
+	void	ContinueStroke(CRegionView *pView, CPoint point);
+	void	EndStroke(CRegionView *pView);
+
+	// Ctrl + wheel changes the radius, Ctrl + Shift + wheel the strength. Only
+	// handled while the tool window is open; returns true when it used the wheel.
+	bool	HandleMouseWheel(short zDelta);
+
+	// Brush reticle under the mouse while the tool window is open.
+	void	UpdateHover(CRegionView *pView, CPoint point);
+	void	DrawReticle(DrawBase *pDraw);
+}
+
+#endif
