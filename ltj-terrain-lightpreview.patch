+			pProp = &ppClassDefs[i]->m_Props[j];
+
+			if(pProp->m_PropType >= NUM_PROPERTYTYPES || pProp->m_PropType < 0)
+				pProp->m_PropType = NUM_PROPERTYTYPES;
+		}
+	}
+}
