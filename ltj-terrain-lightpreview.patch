+libs\ButeMgr\stdafx.cpp
+libs\CryptMgr\blowfish.cpp
+libs\CryptMgr\cryptmgr.cpp
+libs\dibmgr\dib.cpp
+libs\dibmgr\dibmgr.cpp
+libs\dibmgr\dibpal.cpp
+libs\genregmgr\genregmgr.cpp
+libs\lith\basehash.cpp
+libs\lith\baselist.cpp
+libs\lith\baselistcounter.cpp
