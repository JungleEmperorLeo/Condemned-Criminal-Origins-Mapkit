+// Free flight: Z toggles mouse look; W A S D fly the camera (Hammer style).
+void CRegionView::SetMouseLook(BOOL bOn)
+{
+	if(bOn == m_bMouseLook)
+		return;
+
+	if(bOn)
+	{
+		if(!m_bInFocus || !IsPerspectiveViewType())
+			return;
+
+		CRect rc;
+		GetClientRect(&rc);
+		CPoint tl(rc.left, rc.top), br(rc.right, rc.bottom);
+		ClientToScreen(&tl);
+		ClientToScreen(&br);
+		CRect rcScreen(tl, br);
+		::ClipCursor(&rcScreen);
+
+		CPoint center = rc.CenterPoint();
+		ClientToScreen(&center);
+		::SetCursorPos(center.x, center.y);
+
+		while(::ShowCursor(FALSE) >= 0) {}
+		m_dwMouseLookTick = GetTickCount();
+		m_bMouseLook = TRUE;
+	}
+	else
+	{
+		m_bMouseLook = FALSE;
+		::ClipCursor(NULL);
+		while(::ShowCursor(TRUE) < 0) {}
+	}
+}
+
+void CRegionView::UpdateMouseLook()
+{
+	DWORD now = GetTickCount();
+	float dt = (float)(now - m_dwMouseLookTick) * 0.001f;
+	m_dwMouseLookTick = now;
+	if(dt > 0.1f)
+		dt = 0.1f;
+
+	CNavigator *pNav = &Nav();
+	bool bChanged = false;
+
+	// Turn with the mouse, then put the cursor back in the middle.
+	CRect rc;
+	GetClientRect(&rc);
+	CPoint center = rc.CenterPoint();
+	ClientToScreen(&center);
+	CPoint cur;
+	::GetCursorPos(&cur);
+	int dx = cur.x - center.x, dy = cur.y - center.y;
+	if(dx || dy)
+	{
+		float xAngle = (float)dy * 0.005f;
+		float yAngle = (float)dx * 0.005f;
+		if(GetApp()->GetOptions().GetControlsOptions()->IsInvertMouseY())
+			xAngle *= -1.0f;
+
+		pNav->ORotY(yAngle);
+		pNav->ORotX(xAngle);
+
+		// Keep the camera from rolling.
+		pNav->Right().y = 0;
+		pNav->Right().Norm();
+		pNav->MakeForward();
+		pNav->Forward().Norm();
+		pNav->MakeUp();
+		pNav->Up().Norm();
+
+		::SetCursorPos(center.x, center.y);
+		bChanged = true;
+	}
+
+	// Fly with W A S D.
+	float fForward = 0.0f, fRight = 0.0f;
+	if(GetAsyncKeyState('W') & 0x8000)	fForward += 1.0f;
+	if(GetAsyncKeyState('S') & 0x8000)	fForward -= 1.0f;
+	if(GetAsyncKeyState('D') & 0x8000)	fRight += 1.0f;
+	if(GetAsyncKeyState('A') & 0x8000)	fRight -= 1.0f;
+	if(fForward != 0.0f || fRight != 0.0f)
+	{
+		float fUnitsPerSecond = 350.0f;
+		if(GetAsyncKeyState(VK_SHIFT) & 0x8000)
+			fUnitsPerSecond *= 3.0f;	// Shift flies faster
+		pNav->Pos() += pNav->Forward() * (fForward * fUnitsPerSecond * dt);
+		pNav->Pos() += pNav->Right() * (fRight * fUnitsPerSecond * dt);
+		bChanged = true;
+	}
+
+	if(bChanged)
+		Invalidate(FALSE);
+}
+
