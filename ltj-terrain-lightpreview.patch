+	static int		g_nCycleSeconds	= 30;
+	static UINT_PTR	g_nTimer		= 0;
+
+	static COptionsDisplay* GetDisplay()
+	{
+		return GetApp() ? GetApp()->GetOptions().GetDisplayOptions() : NULL;
+	}
+
+	static void StopTimer()
+	{
+		if(g_nTimer)
+		{
+			::KillTimer(NULL, g_nTimer);
+			g_nTimer = 0;
+		}
+	}
